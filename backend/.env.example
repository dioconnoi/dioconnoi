# Postgres connection
DATABASE_URL=postgres://visa_checker:visa_checker@localhost:5432/visa_checker_dev

# JWT session tokens issued by this backend after verifying Google sign-in
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d

# Google OAuth — create an OAuth 2.0 Client ID (type: Chrome Extension) in
# Google Cloud Console and put the same value in extension/manifest.json's
# oauth2.client_id. See docs/SETUP.md.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Shared secret for the minimal admin config endpoint (GET/PUT /api/admin/config/:key)
ADMIN_API_KEY=change-me-too

# Stripe (test mode keys while developing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# Register of Licensed Sponsors CSV — the real gov.uk publication URL.
# scripts/refresh-sponsors.ts also accepts a local file path via --source,
# which overrides this for local/offline ingestion.
SPONSOR_REGISTER_CSV_URL=https://www.gov.uk/government/publications/register-of-licensed-sponsors-workers

# Seed-only default for the app_config.free_daily_quota row (the live value
# lives in Postgres and is admin-adjustable afterwards, not re-read from env).
FREE_DAILY_QUOTA_DEFAULT=20

# Comma-separated list of allowed extension origins, e.g.
# chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_ALLOWED_ORIGINS=

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
